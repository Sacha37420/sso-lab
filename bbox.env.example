# ── Routeur : renseigner la Freebox OU la Bbox (setup2.sh choisit d'après ces lignes ;
#    si les deux sont présentes, il demande laquelle au terminal) ──────────────────

# ── Freebox (Free) — jeton d'application : bash scripts/open-freebox-ports.sh authorize
#    (aucun mot de passe : l'API Freebox ne l'accepte pas)
#FREEBOX_IP=192.168.1.254

# ── Bbox (Bouygues Telecom) ──────────────────────────────────────────────────
BBOX_URL=https://mabbox.bytel.fr
# IP LAN de la bbox
BBOX_IP=192.168.1.254

# Mot de passe administrateur de la bbox
BBOX_ADMIN_PASSWORD=CHANGE_ME

# ── Adresses du serveur (source de vérité — propagées via reset_url.sh) ───────
SERVER_URL_LAN=http://192.168.1.X
SERVER_URL_WAN=http://VOTRE_IP_WAN
