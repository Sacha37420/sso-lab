# ─────────────────────────────────────────────────────────────────
# init.ldif — Initialisation de l'annuaire OpenLDAP
#
# Structure :
#   dc=ssolab,dc=local          ← racine (créée automatiquement)
#   └── ou=people               ← unité organisationnelle : users
#       ├── uid=sacha
#       ├── uid=hassan
#       ├── uid=lea
#       ├── uid=elodie
#       ├── uid=sabrina
#       ├── uid=bruno
#       ├── uid=marie
#       ├── uid=e2e_member      ← compte de test E2E, membre de TOUS les groupes
#       ├── uid=e2e_outsider    ← compte de test E2E, membre d'AUCUN groupe
#       └── uid=e2edev          ← compte de test E2E du parcours développeur, membre de developers seul
#   └── ou=groups               ← unité organisationnelle : groupes
#       ├── cn=developers       ← sacha, hassan        (app : analyse-lora)
#       ├── cn=admins           ← sacha
#       ├── cn=famille          ← sacha, lea, elodie, marie
#       ├── cn=amis             ← sacha, hassan, lea
#       ├── cn=dom              ← (naty déplacée vers dev2/ le 2026-07-29 — groupe vide de membre réel, encore requis par app-builder/storage)
#       ├── cn=harem            ← sacha (Carpeta déplacée vers dev2/ le 2026-07-29 — groupe encore requis par app-builder/storage)
#       ├── cn=manager          ← sacha, elodie, sabrina (app : restauration)
#       ├── cn=cuisinier        ← sacha                (app : restauration)
#       ├── cn=serveur          ← sacha                (app : restauration)
#       └── cn=proprietaires    ← sacha, elodie, bruno (app : conciergerie, portail propriétaires)
#
# Groupes requis par les applications. Double verrou :
#   - barrière navigateur : flow Keycloak require-<client> (rôle <client>-access)
#   - serrure API         : le backend vérifie 'azp' + le claim JWT "groups"
#
#   - app-builder                    : admins
#   - analyse-lora                   : developers
#   - front-cadriciel                : developers
#   - test-angular                   : developers
#   - test-django                    : developers
#   - test-django-angular            : developers
#   - traitement-de-fichiers-compils : developers
#   - arbre-genealogique             : famille
#   - restauration                   : manager, cuisinier, serveur
#   - conciergerie                   : proprietaires, admins
#
# ⚠ Un compte sans groupe n'a accès à AUCUNE application. C'est voulu.
#
# e2e_member / e2e_outsider (voir CLAUDE.md, section "Tests end-to-end") :
# comptes synthétiques utilisés par runner/ pour automatiser la vérification
# de cloisonnement de chaque app. e2e_member doit être membre de TOUS les
# groupes ci-dessus ; e2e_outsider d'aucun. Tout nouveau groupe créé ici DOIT
# ajouter e2e_member comme membre, sinon les tests E2E des apps qui
# l'utilisent cassent en silence. Ajoutés en direct sur l'annuaire vivant
# (ldapadd) le 2026-07-27 — ce fichier n'est rejoué qu'à l'init du volume,
# donc les entrées ci-dessous ne servent que de référence pour un futur
# --restart-sso-lab, déjà appliquées à chaud.
#
# Le fichier est chargé UNE SEULE FOIS au premier démarrage.
# Pour le recharger : docker compose down --volumes  puis  up
# ─────────────────────────────────────────────────────────────────

# ── Unité organisationnelle : utilisateurs ────────────────────────
dn: ou=people,dc=ssolab,dc=local
objectClass: organizationalUnit
ou: people

# ── Unité organisationnelle : groupes ─────────────────────────────
dn: ou=groups,dc=ssolab,dc=local
objectClass: organizationalUnit
ou: groups

# ── Utilisateur : sacha ───────────────────────────────────────────
# inetOrgPerson = schéma standard pour les personnes (email, prénom…)
# shadowAccount = permet un mot de passe hashé
dn: uid=sacha,ou=people,dc=ssolab,dc=local
objectClass: inetOrgPerson
objectClass: shadowAccount
uid: sacha
cn: Sacha
sn: Sacha
givenName: Sacha
mail: sacha@ssolab.local
# Mot de passe en clair — OpenLDAP le hashera en SHA au démarrage
userPassword: CHANGE_ME

# ── Utilisateur : hassan ──────────────────────────────────────────
dn: uid=hassan,ou=people,dc=ssolab,dc=local
objectClass: inetOrgPerson
objectClass: shadowAccount
uid: hassan
cn: Hassan
sn: Hassan
givenName: Hassan
mail: hassan@ssolab.local
userPassword: CHANGE_ME

# ── Utilisateur : lea ─────────────────────────────────────────────
dn: uid=lea,ou=people,dc=ssolab,dc=local
objectClass: inetOrgPerson
objectClass: shadowAccount
uid: lea
cn: Léa
sn: Lea
givenName: Léa
mail: lea@ssolab.local
userPassword: CHANGE_ME

