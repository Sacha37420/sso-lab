cn: Élodie
sn: Elodie
givenName: Élodie
mail: elodie@ssolab.local
userPassword: CHANGE_ME

# ── Utilisateur : sabrina ─────────────────────────────────────────
dn: uid=sabrina,ou=people,dc=ssolab,dc=local
objectClass: inetOrgPerson
objectClass: shadowAccount
uid: sabrina
cn: Sabrina
sn: Sabrina
givenName: Sabrina
mail: sabrina@ssolab.local
userPassword: CHANGE_ME

# ── Utilisateur : bruno ───────────────────────────────────────────
dn: uid=bruno,ou=people,dc=ssolab,dc=local
objectClass: inetOrgPerson
objectClass: shadowAccount
uid: bruno
cn: Bruno
sn: Bruno
givenName: Bruno
mail: bruno@ssolab.local
userPassword: CHANGE_ME

# ── Utilisateur : marie ───────────────────────────────────────────
# Mot de passe choisi par l'utilisatrice — le préserver lors d'une rotation :
#   bash init-secrets.sh --init-ldif-password --keep-password marie
dn: uid=marie,ou=people,dc=ssolab,dc=local
objectClass: inetOrgPerson
objectClass: shadowAccount
uid: marie
cn: Marie
sn: Marie
givenName: Marie
mail: marie@ssolab.local
userPassword: CHANGE_ME

# ── Utilisateur (synthétique) : e2e_member ─────────────────────────
dn: uid=e2e_member,ou=people,dc=ssolab,dc=local
objectClass: inetOrgPerson
objectClass: shadowAccount
uid: e2e_member
cn: E2E Member
sn: Member
givenName: E2E
# Adresse FACTICE (@ssolab.local) et non une vraie boîte : le claim `email` est
# exigé par l'authentification de toutes les APIs du lab (api/authentication.py
# refuse un token sans lui), donc sans `mail` ce compte passait le flow de page
# mais prenait un 403 sur le moindre appel API — ce qui interdisait de vérifier
# un parcours applicatif de bout en bout. Le domaine .local est reconnu comme
# factice par notify-password-email.sh, qui n'enverra donc jamais de mail de
# rotation à ce compte synthétique.
mail: e2e_member@ssolab.local
userPassword: CHANGE_ME

# ── Utilisateur (synthétique) : e2e_outsider ───────────────────────
dn: uid=e2e_outsider,ou=people,dc=ssolab,dc=local
objectClass: inetOrgPerson
objectClass: shadowAccount
uid: e2e_outsider
cn: E2E Outsider
sn: Outsider
givenName: E2E
userPassword: CHANGE_ME

# ── Utilisateur (synthétique) : e2edev ─────────────────────────────
# Compte de test du parcours « développeur » (lab multi-dev, voir CLAUDE.md) :
# membre de `developers` SEULEMENT — ni `admins`, ni aucun autre groupe. Son uid
# sans tiret bas est ce qui lui permet d'être inscrit comme dev (e2e_member ne le
# peut pas). Adresse factice @ssolab.local, même raison que e2e_member.
dn: uid=e2edev,ou=people,dc=ssolab,dc=local
objectClass: inetOrgPerson
objectClass: shadowAccount
uid: e2edev
cn: E2E Dev
sn: Dev
givenName: E2E
mail: e2edev@ssolab.local
userPassword: CHANGE_ME

# ── Groupe : developers ───────────────────────────────────────────
# groupOfNames = groupe dont les membres sont des DN complets
dn: cn=developers,ou=groups,dc=ssolab,dc=local
objectClass: groupOfNames
cn: developers
member: uid=sacha,ou=people,dc=ssolab,dc=local
member: uid=hassan,ou=people,dc=ssolab,dc=local
member: uid=e2e_member,ou=people,dc=ssolab,dc=local
member: uid=e2edev,ou=people,dc=ssolab,dc=local

