{
  "version": 1,
  "_doc": "Registre de lab-media (contrat I1/I4). Aucun secret ici : ils sont dans .env sous des noms dérivés (voir README.md). Lu au démarrage de lab-media-auth.",
  "apps": {
    "peripheriques": {
      "prefixes": ["webcam"],
      "read_hook": "http://peripheriques-backend:8000/api/media-auth/"
    }
  },
  "sources": {
    "capture": {
      "paths": ["webcam/av", "webcam/video", "webcam/audio"]
    }
  },
  "paths": {
    "webcam/av": {"record": true, "segment": "1h", "delete_after": "7d"},
    "webcam/video": {},
    "webcam/audio": {}
  }
}
