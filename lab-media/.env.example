# lab-media/.env — secrets et réglages de la brique des flux audio/vidéo.
# Aucune de ces valeurs n'est versionnée. Secrets : [A-Za-z0-9_-] seulement, 16 caractères au
# moins (`openssl rand -hex 24`). lab-media-auth refuse de démarrer sur une clé absente,
# trop courte ou restée à CHANGE_ME.

# ── Propagés par scripts/reset_url.sh (ne pas remplir à la main) ──────────────
DOMAIN=CHANGE_ME
HOST_DEV_ROOT=

# ── Source « webcams de l'hôte » ──────────────────────────────────────────────
# Laisser COMPOSE_PROFILES vide pour faire tourner la brique sans webcam ni micro.
COMPOSE_PROFILES=capture
# Toute webcam USB branchée est découverte ; au plus MEDIA_CAPTURE_MAX (0 à 8) sont capturées en
# même temps, les autres attendent (état « waiting »). Un encodage 720p15 ≈ 1/3 de cœur.
MEDIA_CAPTURE_MAX=2
# (MEDIA_DEVICE_VIDEO / MEDIA_DEVICE_AUDIO ne sont plus lues : la découverte les remplace.)
# device (défaut) ou testsrc (mire + bip synthétiques, n'ouvre aucun périphérique)
MEDIA_CAPTURE_MODE=device
LAB_MEDIA_SOURCE_CAPTURE_PUBLISH_USER=capture
LAB_MEDIA_SOURCE_CAPTURE_PUBLISH_PASSWORD=CHANGE_ME

# ── WebRTC (ICE) ──────────────────────────────────────────────────────────────
# UDP + TCP, publié sur l'hôte et redirigé sur la Bbox ; hôtes annoncés aux navigateurs.
MEDIA_WEBRTC_PORT=8189
MEDIA_WEBRTC_HOSTS=VOTRE_IP_WAN,192.168.1.X

# ── MediaMTX → lab-media-auth ─────────────────────────────────────────────────
LAB_MEDIA_HOOK_KEY=CHANGE_ME
# Délai TOTAL accordé au hook de lecture d'une app, en secondes (0.2 à 8 ; MediaMTX abandonne
# lui-même à 10 s). Au-delà : lecture refusée.
LAB_MEDIA_READ_HOOK_TIMEOUT_S=3

# ── Une section par app du registre (registry.json) ───────────────────────────
# Nom de clé = LAB_MEDIA_APP_<NOM EN MAJUSCULES, « - » → « _ »>_…
# HOOK_KEY          : clé que lab-media-auth présente au hook de lecture de l'app (?key=)
#                     → même valeur que MEDIA_HOOK_KEY dans le .env de l'app.
# CONTROL_USER/PASS : identifiants de l'app sur l'API de contrôle (API.md)
#                     → mêmes valeurs que MEDIA_INTERNAL_USER/PASSWORD dans le .env de l'app.
# PUBLISH_USER/PASS : seulement si l'app a "publish": true dans le registre.
LAB_MEDIA_APP_PERIPHERIQUES_HOOK_KEY=CHANGE_ME
LAB_MEDIA_APP_PERIPHERIQUES_CONTROL_USER=peripheriques
LAB_MEDIA_APP_PERIPHERIQUES_CONTROL_PASSWORD=CHANGE_ME

# ── Sources tirées (caméra IP) : une clé par chemin qui déclare "source_env" ──
# LAB_MEDIA_PULL_EXEMPLE=rtsp://utilisateur:motdepasse@192.168.1.50:554/stream1
