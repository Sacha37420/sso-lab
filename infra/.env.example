# infra/.env — copié de ce gabarit par scripts/install.sh, qui génère les mots
# de passe marqués CHANGE_ME. Ne JAMAIS y écrire de clé DEV_* ni LAB_PG_PASSWORD :
# ce fichier est l'env_file de dev-postgres et de dev-pgadmin (tout ce qu'on y
# met est injecté dans ces conteneurs) — les mots de passe des rôles applicatifs
# vivent dans infra/dev-roles.env, écrit par scripts/dev-db.sh.

# ── Ports utilisés ───────────────────────────────────────────────
HPORT_POSTGRES=5432
PORT_PGADMIN=5050
PORT_KEYCLOAK=8080

# ── PostgreSQL — instance par défaut (dev-postgres) ──────────────
# devuser est le rôle d'ADMINISTRATION de l'instance (superutilisateur) : seuls
# les scripts s'en servent, par le socket local du conteneur. Aucune app ne se
# connecte avec lui : chacune a le rôle de son propriétaire (dev_<uid>) ou le
# rôle `lab` du cadriciel. La base devdb reste vide.
# POSTGRES_PASSWORD n'est lu qu'à la création du volume (ensuite :
# scripts/rotate-db-password.sh). Généré par scripts/init-secrets.sh.
POSTGRES_DB=devdb
POSTGRES_USER=devuser
POSTGRES_PASSWORD=CHANGE_ME

# ── PostGIS — seconde instance (dev-postgis), apps SIG ───────────
# Noms de clés DISTINCTS de POSTGRES_* : reset_url.sh propage chacun sous sa
# propre clé. gisuser = rôle d'administration, comme devuser ci-dessus.
POSTGIS_DB=gisdb
POSTGIS_USER=gisuser
POSTGIS_PASSWORD=CHANGE_ME

# ── pgAdmin — compte bootstrap (initialisation interne uniquement) ──
PGADMIN_DEFAULT_EMAIL=admin@pgadmin.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME

# ── pgAdmin — OAuth2 Keycloak ─────────────────────────────────────
# Secret du client « pgadmin » du realm ssolab — écrit par
# infra/setup-keycloak-pgadmin.sh (lancé par scripts/install.sh).
KEYCLOAK_CLIENT_SECRET=CHANGE_ME

# ── Adresses (propagées par scripts/reset_url.sh — ne pas remplir à la main) ──
SERVER_URL_LAN=http://192.168.1.X
SERVER_URL_WAN=http://VOTRE_IP_WAN
KEYCLOAK_URL=http://192.168.1.X:8080
KEYCLOAK_REALM=ssolab
KEYCLOAK_CLIENT_ID=infra
KEYCLOAK_ISSUER_URI=http://192.168.1.X:8080/realms/ssolab
KEYCLOAK_PUBLIC_URL=http://VOTRE_IP_WAN:8080

# ── HTTPS / Caddy ─────────────────────────────────────────────────
DOMAIN=CHANGE_ME

KEYCLOAK_REQUIRED_GROUPS=
