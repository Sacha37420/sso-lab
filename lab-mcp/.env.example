# lab-mcp/.env — créé depuis ce fichier par scripts/install.sh, qui y écrit
# LAB_UID, LAB_GID et DOCKER_GID d'après la machine (ne pas copier les valeurs
# ci-dessous telles quelles sur un autre hôte). Aucun secret ici : le serveur n'en
# détient aucun au repos.

# Propagés automatiquement par scripts/reset_url.sh (ne pas remplir à la main).
DOMAIN=CHANGE_ME
HOST_DEV_ROOT=
LAB_WORK_DIR=

# Compte sous lequel le serveur tourne dans le conteneur : celui du propriétaire
# du dépôt sur l'hôte (`id -u`, `id -g`), pour que les fichiers créés par les
# scripts lui appartiennent.
LAB_UID=1000
LAB_GID=1000
# GID du groupe `docker` de l'HÔTE (`getent group docker | cut -d: -f3`) :
# c'est lui qui donne accès au socket monté.
DOCKER_GID=989

# Espaces de travail (I3) — laisser vides pour les défauts du contrat.
# LAB_WS_IMAGE=lab-workspace:latest
# LAB_WS_MAX=3
# LAB_WS_IDLE_MIN=30
# pgAdmin par dev (I9)
# LAB_PG_MAX=3
